# Contact form → Resend. Copy the relevant lines into .env.local (local dev)
# and into Vercel → Project → Settings → Environment Variables (production).

# Required. From https://resend.com/api-keys
RESEND_API_KEY=

# Optional. The verified "from" address. The DOMAIN must be verified in Resend
# first (DNS records). If unset, the form sends from Resend's shared
# onboarding@resend.dev, which only delivers to your own Resend account email.
# Example: MÍA Foundation <formulario@mujerinfluenciaactualfoundation.org>
CONTACT_FROM=

# Optional. Where form submissions are delivered.
# Defaults to miainfluencias@gmail.com if unset.
CONTACT_TO=

# Optional. Where nominee registrations (/api/nomination) are delivered.
# Defaults to oficial@miainfluencia.com if unset. Shares RESEND_API_KEY + CONTACT_FROM.
NOMINATION_TO=
